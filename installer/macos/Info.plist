<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app bundle's Info.plist. .github/workflows/release-v2-unix.yml replaces @SHORT_VERSION@
     (MAJOR.MINOR.PATCH), @BUILD@ (an integer that only grows) and @SEMVER@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>CodeShellManager</string>
  <key>CFBundleName</key>
  <string>CodeShellManager</string>
  <key>CFBundleExecutable</key>
  <string>codeshell</string>
  <key>CFBundleIdentifier</key>
  <string>ai.umage.CodeShellManager</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@BUILD@</string>
  <key>CFBundleGetInfoString</key>
  <string>CodeShellManager @SEMVER@</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>umage.ai. MIT OR Apache-2.0.</string>
  <!-- Shells and CLIs started in CodeShellManager's terminals are attributed to the app by macOS
       privacy controls (TCC), so these prompts name what the person's own commands are doing. -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may read and write files on your Desktop.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may read and write files in Documents.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may read and write files in Downloads.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may read and write files on removable volumes.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may read and write files on network volumes.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>Commands you run in CodeShellManager's terminals may control other apps.</string>
</dict>
</plist>
