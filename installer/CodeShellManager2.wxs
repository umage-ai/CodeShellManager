<?xml version="1.0" encoding="UTF-8"?>
<!-- CodeShellManager (version 2, the Rust app). Built by .github/workflows/release-v2.yml with
       -d Version=<numeric; docs/release.md, "Version scheme"> -d PublishDir=<dir> -d Channel=stable|beta
     See docs/release.md for every identity below and why it has the value it has.

     Channel=stable (rc and final releases): THE CodeShellManager. It carries the WPF app's
       (0.x) UpgradeCode, product name and shortcut names, so it major-upgrades an installed WPF
       CodeShellManager (MSI, winget and Chocolatey upgrades all go through this), and it also
       removes a "CodeShellManager Beta" install. The install folder is NOT the WPF app's: version
       2 installs under C:\Program Files\umage.ai\ (the company name reads "umage.ai" everywhere),
       a clean break from C:\Program Files\umage\ where 0.x and 2.0 betas lived. The old product is
       removed first, taking its files, and the empty old folders are cleaned up below.
     Both channels' exes are built with CSM_CHANNEL set to the channel: a beta keeps its own
       data folders (CodeShellManager2-Beta) and IPC app id (codeshell-beta).
     Channel=beta: "CodeShellManager Beta", installed BESIDE the WPF app with its own
       UpgradeCode, folder, Start-menu entry and app id, so a beta never upgrades or removes it. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef Channel ?>
    <?define Channel = "beta" ?>
  <?endif?>

  <!-- Build order (SEC-48; docs/release.md, "Version scheme"): an integer the release workflow
       computes, -d BuildOrder=<n>, with -d BuildOrderGuid=<guid> (unique per build order).
       0 (the default, and every dev build) means: no check, nothing recorded of its own. -->
  <?ifndef BuildOrder ?>
    <?define BuildOrder = "0" ?>
  <?endif?>
  <?ifndef BuildOrderGuid ?>
    <?define BuildOrderGuid = "B2F6E0D4-7C1A-4E58-9A3D-5C8E1F40A7B9" ?>
  <?endif?>

  <!-- The beta's own UpgradeCode. The stable channel removes an install of it (below). -->
  <?define BetaUpgradeCode = "8B16A8B3-05F0-4048-B8DD-40B3AC84FF55" ?>

  <?if $(var.Channel) = "stable" ?>
    <?define ProductName = "CodeShellManager" ?>
    <!-- The WPF app's UpgradeCode (installer/CodeShellManager.wxs on main). Never change it:
         it is what lets this MSI, `winget upgrade` and `choco upgrade` replace the WPF app. -->
    <?define UpgradeCode = "3F7A9B1C-2D5E-4F8A-B0C3-6E1D9A4F2B7E" ?>
    <?define FolderName = "CodeShellManager" ?>
    <?define RegistryKey = "Software\umage.ai\CodeShellManager" ?>
    <!-- Must match the codeshell.aumid file the workflow writes into PublishDir. -->
    <?define AppUserModelId = "UmageAI.CodeShellManager" ?>
  <?elseif $(var.Channel) = "beta" ?>
    <?define ProductName = "CodeShellManager Beta" ?>
    <?define UpgradeCode = "$(var.BetaUpgradeCode)" ?>
    <?define FolderName = "CodeShellManager Beta" ?>
    <?define RegistryKey = "Software\umage.ai\CodeShellManager2Beta" ?>
    <?define AppUserModelId = "UmageAI.CodeShellManager.Beta" ?>
  <?else?>
    <?error Channel must be "stable" or "beta" ?>
  <?endif?>

  <!-- perMachine, as the WPF app's MSI: an MSI major upgrade only finds products of its own
       scope, so changing this would install a second copy instead of upgrading. -->
  <Package Name="$(var.ProductName)"
           Manufacturer="umage.ai"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine">

    <!-- Pre-releases share the first three version fields (2.0.0.N) and MSI ignores the fourth,
         so a same-version upgrade must replace the old build rather than install a second copy.
         The WPF app's versions (0.x) are always lower, so they are always upgraded. The old
         product is removed before the new one is installed (the default schedule), so the WPF
         app's files (CodeShellManager.exe, Assets\) leave its folder (C:\Program Files\umage\...,
         not this product's); its data does not. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallValidate"
                  DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed. Please uninstall it first." />

    <!-- Build-order guard (SEC-48). Windows Installer compares only the first three version
         fields, so the version alone cannot stop beta.2 replacing beta.5. Each tagged build
         instead records its BuildOrder under HKLM (component BuildOrderRecord, below); this
         search reads the value of an install that is already there, before anything is removed,
         and the launch condition refuses a build whose order is lower.
         - Installed is true on repair, uninstall and maintenance, so those never trip it.
         - The same build again: its order is not lower, and it is a repair anyway.
         - A garbage value (not an integer) compares false, so it never blocks.
         - ALLOWOLDER=1 on the msiexec command line is the escape hatch (a deliberate downgrade).
         - BuildOrder 0 (dev builds) has no condition at all. -->
    <Property Id="CSMBUILDORDER">
      <RegistrySearch Id="BuildOrderSearch" Root="HKLM" Key="$(var.RegistryKey)" Name="BuildOrder"
                      Type="raw" Bitness="always64" />
    </Property>
    <?if $(var.BuildOrder) != "0" ?>
    <Launch Condition="Installed OR ALLOWOLDER OR NOT (CSMBUILDORDER &gt; $(var.BuildOrder))"
            Message="A newer $(var.ProductName) build (build order [CSMBUILDORDER]) is already installed. Uninstall it first to go back to an older build, or run the installer with ALLOWOLDER=1." />
    <?endif?>

    <?if $(var.Channel) = "stable" ?>
    <!-- A CodeShellManager Beta install is removed too, found by its UpgradeCode (never by its
         name, which was "CodeShellManager 2 Beta" before). Betas built before the beta data
         folder existed shared %AppData%\CodeShellManager2 with this app, and both put a `csm` on
         PATH. The person's data is never touched by an uninstall. -->
    <Upgrade Id="$(var.BetaUpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="no" Property="CSMBETAFOUND" />
    </Upgrade>
    <?endif?>

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="apps\codeshell\assets\codeshell.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/umage-ai/CodeShellManager" />

    <!-- No folder page: the install folder is fixed (Program Files\umage.ai\...), because this
         folder goes on the SYSTEM PATH and a user-chosen one (e.g. a writable folder) would put
         an attacker-writable directory on every user's PATH. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf"  Value="installer\License.rtf" />
    <WixVariable Id="WixUIBannerBmp"   Value="installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp"   Value="installer\dialog.bmp" />

    <Feature Id="ProductFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Start at sign-in (Settings > General > Start-up) is the user's own Run value
         (HKCU\Software\Microsoft\Windows\CurrentVersion\Run, value CodeShellManager), written by
         the app, never by this MSI.
         The app keeps it pointing at itself: after an install or upgrade into a new folder, the
         AutostartRefresh action (codeshell.exe with the autostart-refresh flag) rewrites an existing
         value to the new exe, and a real uninstall (not the removal half of an upgrade) runs
         AutostartRemove, which deletes the value when it starts this exe or a program that no
         longer exists. Both run as the installing user (Impersonate), so HKCU is theirs; other
         users' values are left and point at a missing exe, which Windows skips. Failures never fail
         the install. -->
    <!-- ExeCommand holds a fixed flag only; nothing from the person or the environment. -->
    <CustomAction Id="AutostartRefresh" FileRef="CodeShellExe" ExeCommand="--autostart-refresh"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="AutostartRemove" FileRef="CodeShellExe" ExeCommand="--autostart-remove"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- Upgrade (or uninstall) while the app runs: ask it to quit gracefully BEFORE files are
         replaced. The installed csm.exe (by full path, from the file table) runs the app_quit
         tool, which reaches only this channel's app (stable and beta have separate app ids). It
         is started without waiting (asyncNoWait), so a slow quit cannot hang the installer; if
         the app is still running, Windows Installer's file-in-use handling takes over as before.
         No util:CloseApplication: it matches by exe name only, and both channels' exe is
         codeshell.exe, so a beta install would close the stable app too. ExeCommand is fixed. -->
    <CustomAction Id="QuitRunningApp" FileRef="CsmExe" ExeCommand="app_quit"
                  Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="QuitRunningApp" After="CostFinalize"
              Condition="WIX_UPGRADE_DETECTED OR CSMBETAFOUND OR REMOVE~=&quot;ALL&quot;" />
      <Custom Action="AutostartRefresh" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="AutostartRemove" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>

  <!-- ── Directory layout ──────────────────────────────────────────────────── -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <!-- Where 0.x and the 2.0 betas lived (see the cleanup components below). Never installed into. -->
      <Directory Id="OldManufacturerFolder" Name="umage">
        <Directory Id="OldInstallFolder" Name="$(var.FolderName)" />
      </Directory>
      <Directory Id="ManufacturerFolder" Name="umage.ai">
        <Directory Id="INSTALLFOLDER" Name="$(var.FolderName)">
          <!-- Sample add-ons. Settings > Add-ons > "Install samples" copies them into the
               person's own add-ons folder; they stay disabled until enabled there. -->
          <Directory Id="SamplesFolder" Name="samples">
            <Directory Id="SamplesAddonsFolder" Name="addons">
              <Directory Id="SampleCodexCli" Name="codex-cli" />
              <Directory Id="SampleCopilotCli" Name="copilot-cli" />
              <Directory Id="SampleGeminiCli" Name="gemini-cli" />
              <Directory Id="SampleOpenCode" Name="opencode" />
              <Directory Id="SampleReview" Name="review" />
              <Directory Id="SampleSessionSummary" Name="session-summary" />
              <Directory Id="SampleThemes" Name="themes" />
              <Directory Id="SampleThemeFun" Name="theme-fun">
                <Directory Id="SampleThemeFunFonts" Name="fonts" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="$(var.ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- ── Files, PATH and shortcuts ─────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ProductComponents">

      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Id="CodeShellExe" Source="$(var.PublishDir)\codeshell.exe" KeyPath="yes" />
      </Component>

      <!-- The recorded build order (see the guard in the Package). The component's GUID is
           UNIQUE PER BUILD ORDER, on purpose. A GUID shared by every build would make the old
           and new product co-own one component, and whether the old product's removal deletes
           the value the new one needs would then depend on re-costing and on where
           RemoveExistingProducts runs. With distinct GUIDs nothing is shared: the new product's
           component is plainly "not installed", and the old product (removed entirely before the
           new one installs, Schedule="afterInstallValidate" above) deletes only its own value
           before the new one is written. A real uninstall removes the value, so an older build
           can then be installed fresh.
           Dev builds (BuildOrder 0) write nothing of their own: they carry over whatever the
           search found (the replaced product's component takes it away on removal, so without
           this a dev build would lower the record). -->
      <?if $(var.BuildOrder) != "0" ?>
      <Component Id="BuildOrderRecord" Directory="INSTALLFOLDER" Guid="$(var.BuildOrderGuid)">
        <RegistryValue Root="HKLM" Key="$(var.RegistryKey)" Name="BuildOrder" Type="string"
                       Value="$(var.BuildOrder)" KeyPath="yes" />
      </Component>
      <?else?>
      <Component Id="BuildOrderRecord" Directory="INSTALLFOLDER" Guid="$(var.BuildOrderGuid)" Condition="CSMBUILDORDER">
        <RegistryValue Root="HKLM" Key="$(var.RegistryKey)" Name="BuildOrder" Type="string"
                       Value="[CSMBUILDORDER]" KeyPath="yes" />
      </Component>
      <?endif?>

      <!-- The pre-umage.ai folders. 0.x and the 2.0 betas installed to
           C:\Program Files\umage\<FolderName>; the major upgrade removes that product (and its
           files) first. The Directory table names the old folders so that, once they are empty,
           they go too: RemoveFolder (never RemoveFolderEx) deletes a folder only when it is
           empty, so another product's files, a user's own files, or a 0.x copy installed beside
           a beta are never touched. Nothing is created: no CreateFolder here. -->
      <Component Directory="OldInstallFolder" Guid="*">
        <RemoveFolder Id="RemoveOldInstallFolder" On="install" />
        <RegistryValue Root="HKCU" Key="$(var.RegistryKey)" Name="OldInstallFolderChecked" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="OldManufacturerFolder" Guid="*">
        <RemoveFolder Id="RemoveOldManufacturerFolder" On="install" />
        <RegistryValue Root="HKCU" Key="$(var.RegistryKey)" Name="OldManufacturerFolderChecked" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- The CLI and MCP server (`csm`, `csm mcp`). Its folder goes on the system PATH so
           `csm setup` / an agent's MCP config can name it without a full path. -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Id="CsmExe" Source="$(var.PublishDir)\csm.exe" KeyPath="yes" />
        <Environment Id="PathCsm" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>

      <!-- Bundled ConPTY (Microsoft-signed). Both MUST sit beside codeshell.exe: csm-pty loads
           conpty.dll by full path from the exe's folder, and conpty.dll starts OpenConsole.exe
           from its own folder. Missing either silently falls back to the inbox ConPTY. The
           release workflow checks these entries. -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\conpty.dll" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\OpenConsole.exe" KeyPath="yes" />
      </Component>

      <!-- The "Session summary" sample add-on's program. The add-on's addon.toml names it as
           `csm-session-summary`, and the plugin host finds it beside codeshell.exe (the app's own
           folder, which is also on PATH). -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\csm-session-summary.exe" KeyPath="yes" />
      </Component>

      <!-- The "Review" add-on's program (first-party, shipped disabled). Its addon.toml names it
           as `csm-review`; the plugin host finds it beside codeshell.exe. -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\csm-review.exe" KeyPath="yes" />
      </Component>

      <Component Directory="SampleCodexCli" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\codex-cli\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleCopilotCli" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\copilot-cli\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleGeminiCli" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\gemini-cli\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleOpenCode" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\opencode\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleReview" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\review\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleSessionSummary" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\session-summary\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemes" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\themes\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemeFun" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\theme-fun\addon.toml" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemeFunFonts" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\theme-fun\fonts\W95FA.otf" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemeFunFonts" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\theme-fun\fonts\OFL-W95FA.txt" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemeFunFonts" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\theme-fun\fonts\VarelaRound-Regular.ttf" KeyPath="yes" />
      </Component>
      <Component Directory="SampleThemeFunFonts" Guid="*">
        <File Source="$(var.PublishDir)\samples\addons\theme-fun\fonts\OFL-VarelaRound.txt" KeyPath="yes" />
      </Component>

      <!-- Third-party licences (cargo-about, generated by the release workflow). -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\THIRD-PARTY-LICENSES.html" KeyPath="yes" />
      </Component>

      <!-- Tells the app which AppUserModelID its toasts go out under (apps/codeshell/src/os_notify.rs). -->
      <Component Directory="INSTALLFOLDER" Guid="*">
        <File Source="$(var.PublishDir)\codeshell.aumid" KeyPath="yes" />
      </Component>

      <!-- Start Menu shortcut. It carries the AppUserModelID: Windows shows a toast only for an
           id some Start-menu shortcut carries. On the stable channel its name and folder are the
           WPF app's, so the upgrade replaces the old shortcut rather than adding a second. -->
      <Component Directory="AppMenuFolder" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Multi-terminal host for Claude Code"
                  Target="[INSTALLFOLDER]codeshell.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppUserModelId)" />
        </Shortcut>
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall $(var.ProductName)"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="$(var.RegistryKey)"
                       Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopShortcutLink"
                  Name="$(var.ProductName)"
                  Description="Multi-terminal host for Claude Code"
                  Target="[INSTALLFOLDER]codeshell.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="$(var.RegistryKey)"
                       Name="Desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
