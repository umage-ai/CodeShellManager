<Window x:Class="CodeShellManager.Views.BusySessionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sessions still running" SizeToContent="Height" Width="440" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1e1e2e" Foreground="#cdd6f4"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <!-- Same look as the shutdown board (MainWindow ShutdownOverlay): accent stripe, name,
         and a right-hand status column. An owned window rather than an in-window overlay,
         because WebView2 panes are HwndHosts that composite over any WPF overlay, and
         collapsing the terminal grid just to ask a question would black out every pane. -->
    <DockPanel Margin="16,14,16,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeadlineText" Foreground="#cdd6f4" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailText" Foreground="#a6adc8" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="DontAskCheck" Content="Don't warn me again (re-enable in Settings)"
                      Foreground="#6c7086" FontSize="11" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" AutomationProperties.AutomationId="BusyKeepRunningBtn" Content="Keep running" Padding="12,6" Margin="0,0,8,0"
                        Background="#89b4fa" Foreground="#1e1e2e"
                        BorderThickness="0" Cursor="Hand" IsDefault="True" IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="CloseAnywayBtn" AutomationProperties.AutomationId="BusyCloseAnywayBtn" Content="Close anyway" Padding="14,6"
                        Background="#45475a" Foreground="#f38ba8"
                        BorderThickness="0" Cursor="Hand"
                        Click="CloseAnyway_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Background="#181825" CornerRadius="6" BorderBrush="#313244" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="320" Margin="8,6">
                <StackPanel x:Name="RowsPanel"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
