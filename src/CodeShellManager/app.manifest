<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="CodeShellManager.app"/>

  <!--
    Per-monitor DPI awareness (v2). See "DPI awareness" in CLAUDE.md.

    Without this the app was *system* DPI aware: it fixed its scale to the primary
    monitor's DPI at the moment the process started, and Windows bitmap-stretched the
    whole window whenever that stopped matching — moved to another monitor, docked or
    undocked, scale changed in Settings, RDP from a different screen. A process started
    at 150% then stayed at 150% (blurry, shrunk) for its whole lifetime, and because the
    WebView2 browser process renders the terminals at its *own* scale, the terminal and
    the WPF chrome around it could end up at different sizes.

    PerMonitorV2 makes WPF re-layout at the new DPI on every monitor change and lets the
    WebView2 control pass the real monitor scale to the renderer.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Windows 10 1703+: honoured first. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- Older Windows fallback (ignored when dpiAwareness is understood). -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
